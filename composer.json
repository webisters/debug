{
    "name": "webisters/debug",
    "description": "Webisters Debug Library",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "debug",
        "timer",
        "error",
        "handler",
        "error-handling",
        "exception-handling",
        "exception",
        "log",
        "error-reporting",
        "view"
    ],
    "authors": [
        {
            "name": "Hafiz Muhammad Moaz",
            "email": "hafizmoazkhalid@gmail.com",
            "homepage": "https://github.com/HafizMMoaz"
        }
    ],
    "homepage": "https://webisters.com/packages/debug",
    "support": {
        "email": "support@webisters.com",
        "issues": "https://github.com/webisters/debug/issues",
        "forum": "https://github.com/webisters/forum",
        "source": "https://github.com/webisters/debug",
        "docs": "https://webisters.com"
    },
    "funding": [
        {
            "type": "Webisters Sponsor",
            "url": "https://webisters.com/sponsor"
        }
    ],
    "require": {
        "php": ">=8.2",
        "webisters/cli": "*",
        "webisters/helpers": "*",
        "webisters/language": "*",
        "webisters/log": "*"
    },
    "require-dev": {
        "webisters/coding-standard": "*",
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Framework\\Debug\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Debug\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}


